{
  "name": "tigl-qc-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preview": "node scripts/preview-server.mjs",
    "api": "node --experimental-strip-types --env-file-if-exists=.env scripts/start-api.mjs",
    "web": "npm --workspace @tigl-qc/web run dev",
    "db:migrate": "node --env-file-if-exists=.env database/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env database/seed-axis.mjs",
    "db:bootstrap-admin": "node --env-file-if-exists=.env database/bootstrap-admin.mjs",
    "db:audit:verify": "node --env-file-if-exists=.env database/verify-audit.mjs",
    "build": "npm --workspace @tigl-qc/web run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run packages/engine/test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
